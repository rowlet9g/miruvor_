  "fixed_sql": [
    {
      "name": "wine_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"wine_records\" (\"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NULL, \"id\" TEXT NOT NULL, \"name\" TEXT NULL, \"producer\" TEXT NULL, \"country\" TEXT NULL, \"region\" TEXT NULL, \"vintage\" INTEGER NULL, \"vintage_kind\" TEXT NOT NULL DEFAULT 'unknown', \"type\" TEXT NULL, \"grape_varieties_json\" TEXT NOT NULL DEFAULT '[]', \"image_path\" TEXT NULL, \"is_wishlisted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_wishlisted\" IN (0, 1)), \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), PRIMARY KEY (\"id\"), CHECK (length(trim(coalesce(name, ''))) > 0 OR length(trim(coalesce(image_path, ''))) > 0), CHECK ((vintage_kind = 'year' AND vintage IS NOT NULL) OR (vintage_kind IN ('nonVintage', 'unknown') AND vintage IS NULL)), CHECK (type IS NULL OR type IN ('red','white','rose','sparkling','fortified','dessert','other')));"
        }
      ]
    },
    {
      "name": "purchase_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"purchase_records\" (\"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NULL, \"id\" TEXT NOT NULL, \"wine_id\" TEXT NOT NULL REFERENCES wine_records (id) ON DELETE RESTRICT, \"purchase_date\" INTEGER NULL, \"shop_name\" TEXT NULL, \"purchased_quantity\" INTEGER NOT NULL, \"total_paid_krw\" INTEGER NULL, \"volume_ml\" INTEGER NULL, \"note\" TEXT NULL, PRIMARY KEY (\"id\"), CHECK (purchased_quantity > 0), CHECK (total_paid_krw IS NULL OR total_paid_krw >= 0), CHECK (volume_ml IS NULL OR volume_ml > 0));"
        }
      ]
    },
    {
      "name": "bottle_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"bottle_records\" (\"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NULL, \"id\" TEXT NOT NULL, \"wine_id\" TEXT NOT NULL REFERENCES wine_records (id) ON DELETE RESTRICT, \"purchase_id\" TEXT NULL REFERENCES purchase_records (id) ON DELETE SET NULL, \"acquisition_kind\" TEXT NOT NULL DEFAULT 'unknown', \"acquired_at\" INTEGER NULL, \"volume_ml\" INTEGER NULL, \"status\" TEXT NOT NULL DEFAULT 'inStock', \"status_changed_at\" INTEGER NULL, \"image_path\" TEXT NULL, \"storage_location\" TEXT NULL, PRIMARY KEY (\"id\"), CHECK (acquisition_kind IN ('purchase','gift','other','unknown')), CHECK (status IN ('inStock','consumed','gifted','returned')), CHECK (purchase_id IS NULL OR acquisition_kind = 'purchase'), CHECK (volume_ml IS NULL OR volume_ml > 0));"
        }
      ]
    },
    {
      "name": "tasting_note_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tasting_note_records\" (\"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NULL, \"id\" TEXT NOT NULL, \"wine_id\" TEXT NOT NULL REFERENCES wine_records (id) ON DELETE RESTRICT, \"bottle_id\" TEXT NULL REFERENCES bottle_records (id) ON DELETE SET NULL, \"tasted_at\" INTEGER NULL, \"rating\" REAL NULL, \"image_path\" TEXT NULL, \"aroma\" TEXT NULL, \"palate\" TEXT NULL, \"pairing\" TEXT NULL, \"acidity\" INTEGER NULL, \"tannin\" INTEGER NULL, \"body\" INTEGER NULL, \"sweetness\" INTEGER NULL, \"memo\" TEXT NULL, \"buy_again\" TEXT NULL, PRIMARY KEY (\"id\"), CHECK (rating IS NULL OR rating BETWEEN 0 AND 5), CHECK (acidity IS NULL OR acidity BETWEEN 1 AND 5), CHECK (tannin IS NULL OR tannin BETWEEN 1 AND 5), CHECK (body IS NULL OR body BETWEEN 1 AND 5), CHECK (sweetness IS NULL OR sweetness BETWEEN 1 AND 5), CHECK (buy_again IS NULL OR buy_again IN ('yes','no','unsure')), CHECK (rating IS NOT NULL OR buy_again IS NOT NULL OR acidity IS NOT NULL OR tannin IS NOT NULL\n      OR body IS NOT NULL OR sweetness IS NOT NULL OR\n      length(trim(coalesce(image_path,'') || coalesce(aroma,'') || coalesce(palate,'') ||\n      coalesce(pairing,'') || coalesce(memo,''))) > 0));"
        }
      ]
    },
    {
      "name": "price_observation_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"price_observation_records\" (\"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NULL, \"id\" TEXT NOT NULL, \"wine_id\" TEXT NOT NULL REFERENCES wine_records (id) ON DELETE RESTRICT, \"source_name\" TEXT NOT NULL, \"price\" INTEGER NOT NULL, \"observed_at\" INTEGER NOT NULL, \"url\" TEXT NULL, \"note\" TEXT NULL, \"is_in_stock\" INTEGER NULL CHECK (\"is_in_stock\" IN (0, 1)), \"volume_ml\" INTEGER NULL, PRIMARY KEY (\"id\"), CHECK (price >= 0), CHECK (volume_ml IS NULL OR volume_ml > 0));"
        }
      ]
    },
