  "fixed_sql": [
    {
      "name": "wine_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"wine_records\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"producer\" TEXT NOT NULL, \"country\" TEXT NOT NULL, \"region\" TEXT NULL, \"vintage\" INTEGER NULL, \"type\" TEXT NOT NULL, \"grape_varieties_json\" TEXT NOT NULL DEFAULT '[]', \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "bottle_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"bottle_records\" (\"id\" TEXT NOT NULL, \"wine_id\" TEXT NOT NULL REFERENCES wine_records (id), \"purchase_date\" INTEGER NOT NULL, \"purchase_price\" INTEGER NOT NULL, \"shop_name\" TEXT NULL, \"image_path\" TEXT NULL, \"storage_location\" TEXT NULL, \"is_consumed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_consumed\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "tasting_note_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tasting_note_records\" (\"id\" TEXT NOT NULL, \"wine_id\" TEXT NOT NULL REFERENCES wine_records (id), \"bottle_id\" TEXT NULL REFERENCES bottle_records (id), \"tasted_at\" INTEGER NOT NULL, \"rating\" REAL NOT NULL, \"image_path\" TEXT NULL, \"aroma\" TEXT NULL, \"palate\" TEXT NULL, \"pairing\" TEXT NULL, \"acidity\" INTEGER NULL, \"tannin\" INTEGER NULL, \"body\" INTEGER NULL, \"sweetness\" INTEGER NULL, \"memo\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "price_observation_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"price_observation_records\" (\"id\" TEXT NOT NULL, \"wine_id\" TEXT NOT NULL REFERENCES wine_records (id), \"source_name\" TEXT NOT NULL, \"price\" INTEGER NOT NULL, \"observed_at\" INTEGER NOT NULL, \"url\" TEXT NULL, \"note\" TEXT NULL, \"is_in_stock\" INTEGER NULL CHECK (\"is_in_stock\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    }
  ]
